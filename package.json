{
  "name": "tataru-assistant",
  "version": "3.0.3",
  "description": "Tataru Assistant",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "repository": "https://github.com/winw1010/tataru-assistant",
  "keywords": [],
  "author": "https://github.com/winw1010",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@google-cloud/vision": "^6.2.0",
    "@google/genai": "^2.32.0",
    "axios": "^1.21.0",
    "cohere-ai": "^8.3.0",
    "crypto-js": "^4.2.0",
    "node-stream-zip": "^1.16.0",
    "nodejs-file-downloader": "^4.13.0",
    "ollama": "^0.6.4",
    "openai": "^7.47.0",
    "sharp": "^0.35.5",
    "temp": "^0.9.4",
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "com.app.tataru.assistant",
    "productName": "Tataru Assistant",
    "directories": {
      "output": "build"
    },
    "extraFiles": [
      "src/data",
      "!src/data/img/*.png",
      "!src/data/img/*.jpg",
      "signatures.json"
    ],
    "win": {
      "requestedExecutionLevel": "highestAvailable",
      "icon": "src/html/img/icon/tataru.ico",
      "target": "nsis"
    },
    "nsis": {
      "createStartMenuShortcut": true,
      "createDesktopShortcut": "always"
    }
  }
}
