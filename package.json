{
  "name": "tataru-assistant",
  "version": "3.0.0",
  "description": "Tataru Assistant",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "repository": "https://github.com/winw1010/tataru-assistant",
  "keywords": [],
  "author": "https://github.com/winw1010",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "globals": "^17.12.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@google-cloud/vision": "^6.0.0",
    "@google/genai": "^2.21.0",
    "axios": "^1.20.0",
    "cohere-ai": "^8.1.0",
    "crypto-js": "^4.2.0",
    "jsonrepair": "^3.15.0",
    "node-stream-zip": "^1.16.0",
    "nodejs-file-downloader": "^4.13.0",
    "ollama": "^0.6.3",
    "openai": "^7.9.0",
    "sharp": "^0.35.4",
    "temp": "^0.9.4",
    "tesseract.js": "^7.0.0"
  },
  "build": {
    "appId": "com.app.tataru.assistant",
    "productName": "Tataru Assistant",
    "directories": {
      "output": "build"
    },
    "extraFiles": [
      "src/data",
      "!src/data/img/*.png",
      "actions-latest.json",
      "signatures-global-latest.json",
      "signatures.json",
      "statuses-latest.json",
      "structures-global-latest.json",
      "zones-latest.json"
    ],
    "win": {
      "requestedExecutionLevel": "highestAvailable",
      "icon": "src/html/img/icon/tataru.ico",
      "target": "nsis"
    },
    "nsis": {
      "createStartMenuShortcut": true,
      "createDesktopShortcut": "always"
    }
  }
}
